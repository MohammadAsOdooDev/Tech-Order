<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="order_tag_action" model="ir.actions.act_window">
            <field name="name">Tags Application</field>
            <field name="res_model">order.order_tag</field>
            <field name="view_mode">tree,form</field>                
        </record>

        <menuitem
            id="order_tag_menu"
            name="Tags"
            action="order_tag_action"
            parent="orders_main_menu"
            sequence="20"/>

        <record id="order_tag_view_form" model="ir.ui.view">
            <field name="name">order.tag.view.form</field>
            <field name="model">order.order_tag</field>
            <field name="arch" type="xml">
                <form string="Add a new order tag">
                    <sheet>
                        <group string="Tag Information">
                            <field name="name"></field>
                            <field name="color"></field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
    

</odoo>
