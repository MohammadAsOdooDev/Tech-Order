<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="meal_feedback_action" model="ir.actions.act_window">
            <field name="name">Meal Feedback Application</field>
            <field name="res_model">order.meal_feedback</field>
            <field name="view_mode">tree,form</field>
        </record>       
    
        <menuitem
            id="meal_feedback_menu"
            name="Feedbacks"
            action="meal_feedback_action"
            parent="order_meal_menu"
            sequence="10"/>

        <record id="meal_feedback_view_tree" model="ir.ui.view">
            <field name="name">order.meal_feedback.view.tree</field>
            <field name="model">order.meal_feedback</field>
            <field name="arch" type="xml">
                <tree string="Meal Feedbacks">
                    <field name="meal_id"></field>
                    <field name="rate" widget="priority"></field>
                    <field name="customer_id" widget="many2one_avatar_user"></field>
                </tree>
            </field>
        </record>

        <record id="meal_feedback_view_search" model="ir.ui.view">
            <field name="name">meal_feedback.view.search</field>
            <field name="model">order.meal_feedback</field>
            <field name="arch" type="xml">
                <search string="">
                    <group name="meal_feedback_view_search_group">
                        <filter name="meal_feedback_view_search_group_customer_id" string="Customers" context="{'group_by': 'customer_id'}" />
                        <filter name="meal_feedback_view_search_group_meal_id" string="Meals" context="{'group_by': 'meal_id'}" />
                    </group>
                    <filter name="meal_feedback_view_search_good_meal" string="Good Feedbacks" domain="[('rate', '=', '2')]" />
                    <filter name="meal_feedback_view_search_med_meal" string="Med. Feedbacks" domain="[('rate', '=', '1')]" />
                    <filter name="meal_feedback_view_search_bad_meal" string="Bad Feedbacks" domain="[('rate', '=', '0')]" />
                </search>
            </field>
        </record>

        <record id="meal_feedback_view_form" model="ir.ui.view">
            <field name="name">meal_feedback.view.form</field>
            <field name="model">order.meal_feedback</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="meal_id"></field>
                            <field name="customer_id" widget="many2one_avatar_user"></field>      
                            <field name="rate" widget="priority"></field>   
                            <field name="comment" widget="text"></field>   
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
    

</odoo>
